# ==========================================
# توكن البوت الأساسي
# ==========================================
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ==========================================
# لتشغيل أكثر من بوت في نفس الوقت (على نفس استضافة Render مجاناً):
# يمكنك وضع عدة توكنات مفصولة بفواصل:
# BOT_TOKENS=123456:Token1,654321:Token2,987654:Token3
# ==========================================
BOT_TOKENS=

# لتشغيل ملفات بوتات أخرى إضافية مختلفة بجانب هذا البوت (مثل: other_bot.py, ai_bot.py):
# EXTRA_BOTS=other_bot.py
EXTRA_BOTS=

# معرف المشرف (اختياري) - ضع معرفك الرقمي هنا لتفعيل أوامر المشرف
# يمكنك معرفته عبر @userinfobot على تيليجرام
ADMIN_ID=

# ==========================================
# إعدادات Render والتنشيط التلقائي (Keep-Alive):
# المنفذ الذي يطلبه ريندر (ريندر يحدده تلقائياً، افتراضياً 8000 أو 10000)
PORT=8000

# رابط البوت على ريندر (ريندر يضعه تلقائياً RENDER_EXTERNAL_URL، أو يمكنك وضعه هنا يدوياً):
# KEEP_ALIVE_URL=https://your-bot-name.onrender.com
KEEP_ALIVE_URL=

# ==========================================
# إعدادات التحميل
# ==========================================
DOWNLOAD_DIR=downloads
MAX_FILE_SIZE_MB=50
DEFAULT_VIDEO_QUALITY=best
DEFAULT_AUDIO_QUALITY=192
